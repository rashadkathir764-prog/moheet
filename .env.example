# ==============================================================================
# MOHEET | مُحِيط — Environment Variables Template
# ==============================================================================
# ⚠️  تعليمات الاستخدام:
#     1. انسخ هذا الملف وأعد تسميته إلى `.env`
#     2. املأ القيم الحقيقية في ملف `.env` الجديد
#     3. تأكد أن `.env` مُدرَج في `.gitignore` — لا تُرفَع القيم الحقيقية أبداً
#     4. هذا الملف (.env.example) آمن للرفع على GitHub — لا يحتوي على قيم حقيقية
# ==============================================================================


# ------------------------------------------------------------------------------
# 🐳 ENVIRONMENT — بيئة التشغيل
# ------------------------------------------------------------------------------
# القيم المتاحة: development | production | test
NODE_ENV=development


# ------------------------------------------------------------------------------
# 🌐 API SERVER — إعدادات الخادم
# ------------------------------------------------------------------------------
# المنفذ الداخلي الذي يستمع عليه الـ NestJS API داخل الحاوية
API_PORT=3000

# منفذ جهاز التطوير المرتبط بحاوية الـ API
# غيّره إذا كان 3000 مستخدماً من خدمة أخرى على جهازك
API_HOST_PORT=3000

# النطاق المسموح به للـ CORS (يُحدَّد في الإنتاج بالنطاق الفعلي)
# مثال للإنتاج: https://moheet.com,https://admin.moheet.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ------------------------------------------------------------------------------
# 🗄️ DATABASE — قاعدة البيانات (PostgreSQL)
# ------------------------------------------------------------------------------
# اسم المضيف — يطابق اسم الـ service في docker-compose.yml
DB_HOST=moheet-db

# المنفذ الداخلي لـ PostgreSQL داخل الحاوية
DB_PORT=5432

# منفذ جهاز التطوير المرتبط بحاوية PostgreSQL
DB_HOST_PORT=5432

# اسم قاعدة البيانات الرئيسية
DB_NAME=moheet_db

# اسم مستخدم قاعدة البيانات
DB_USER=your_db_username_here

# كلمة مرور قاعدة البيانات — اختر كلمة مرور قوية (12+ حرف)
DB_PASSWORD=your_strong_password_here

# تفعيل سجل الاستعلامات (مفيد في التطوير، يُعطَّل في الإنتاج)
DB_LOGGING=true

# مزامنة الـ Schema تلقائياً (TRUE في التطوير فقط — FALSE في الإنتاج دائماً)
DB_SYNCHRONIZE=false

# تشغيل migrations تلقائياً عند إقلاع التطبيق (يفضل false وتشغيلها بخطوة نشر صريحة)
DB_MIGRATIONS_RUN=false


# ------------------------------------------------------------------------------
# 🔐 JWT — إعدادات التوثيق
# ------------------------------------------------------------------------------
# المفتاح السري لتوقيع الـ Access Tokens
# توليد قيمة آمنة: openssl rand -base64 64
JWT_ACCESS_SECRET=replace_with_a_very_long_random_secret_string_min_64_chars

# مدة صلاحية الـ Access Token (قصيرة لأسباب أمنية)
JWT_ACCESS_EXPIRES_IN=15m

# المفتاح السري لتوقيع الـ Refresh Tokens (مختلف تماماً عن الـ Access)
# توليد قيمة آمنة: openssl rand -base64 64
JWT_REFRESH_SECRET=replace_with_another_completely_different_secret_min_64_chars

# مدة صلاحية الـ Refresh Token
JWT_REFRESH_EXPIRES_IN=7d


# ------------------------------------------------------------------------------
# 📁 FILE STORAGE — تخزين الملفات والصور
# ------------------------------------------------------------------------------
# مزود التخزين النشط: local أو cloudinary
STORAGE_PROVIDER=local

# المسار المحلي لحفظ الملفات المرفوعة
UPLOAD_DEST=./uploads

# الرابط العام الذي تُبنى عليه روابط الصور المخزنة محلياً
UPLOAD_PUBLIC_BASE_URL=http://127.0.0.1:3000/uploads

# إعدادات Cloudinary (مطلوبة عند تفعيل cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=moheet

# الحد الأقصى لحجم الملف المرفوع (بالـ bytes) — 5MB افتراضياً
MAX_FILE_SIZE=5242880

# الامتدادات المسموح برفعها (مفصولة بفاصلة)
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp


# ------------------------------------------------------------------------------
# 🚦 RATE LIMITING — الحد من الطلبات المتكررة
# ------------------------------------------------------------------------------
# الإطار الزمني للقياس (بالميلي ثانية) — 60000 = دقيقة واحدة
THROTTLE_TTL=60000

# الحد الأقصى للطلبات خلال الإطار الزمني لكل IP
THROTTLE_LIMIT=100


# ------------------------------------------------------------------------------
# 📧 EMAIL — البريد الإلكتروني (للمرحلة القادمة)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USER=your_email@moheet.com
MAIL_PASSWORD=your_email_password_here
MAIL_FROM="مُحِيط MOHEET <noreply@moheet.com>"


# ------------------------------------------------------------------------------
# 💾 DEMO SEED DATA — بيانات التغذية التجريبية
# ------------------------------------------------------------------------------
# كلمة المرور الافتراضية للحسابات التجريبية
DEMO_SEED_PASSWORD=DemoPassword123!
